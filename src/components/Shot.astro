---
// Renders a screenshot from src/assets/shots/<src>.{png,jpg,jpeg,webp,avif}
// or, if the file does not exist yet, a placeholder of the same size.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  label: string;
  ratio?: string;
  eager?: boolean;
  class?: string;
}

const { src, label, ratio = '16 / 10', eager = false, class: className } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/shots/**/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
const match = Object.entries(files).find(([path]) =>
  path.replace(/\.[^.]+$/, '') === `/src/assets/shots/${src}`,
);
const image = match?.[1].default;
const dev = import.meta.env.DEV;
---

<figure class:list={['shot', className]} style={`aspect-ratio: ${ratio}`}>
  {image ? (
    <Image
      src={image}
      alt={label}
      widths={[480, 800, 1200, 1600]}
      sizes="(max-width: 800px) 100vw, 800px"
      loading={eager ? 'eager' : 'lazy'}
    />
  ) : (
    <div class="shot-empty" role="img" aria-label={label}>
      <span class="shot-label">{label}</span>
      {dev && <code class="shot-path">src/assets/shots/{src}.webp</code>}
    </div>
  )}
</figure>

<style>
  .shot {
    margin: 0;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface-2);
  }
  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .shot-empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem;
    text-align: center;
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: center;
  }
  .shot-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    max-width: 90%;
  }
  .shot-path {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent-ink);
    word-break: break-all;
  }
</style>
